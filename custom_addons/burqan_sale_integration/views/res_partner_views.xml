<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_burqan_store" model="ir.ui.view">
        <field name="name">res.partner.form.burqan.store</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Burqan" name="burqan_store">
                    <group string="Store link">
                        <field name="x_burqan_store_id"/>
                    </group>
                    <group string="Sales balances">
                        <group>
                            <field name="x_burqan_sales_cash"/>
                            <field name="x_burqan_sales_credit"/>
                            <field name="x_burqan_sales_total"/>
                        </group>
                        <group>
                            <field name="x_burqan_amount_paid"/>
                            <field name="x_burqan_amount_due"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
