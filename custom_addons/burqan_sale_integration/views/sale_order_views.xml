<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_burqan_sale" model="ir.ui.view">
        <field name="name">sale.order.form.burqan.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']/field[@name='client_order_ref']" position="after">
                <field name="x_burqan_order_id" readonly="1"/>
                <field name="x_burqan_payment_type" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
