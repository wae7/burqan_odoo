<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_integration_id" model="ir.ui.view">
        <field name="name">product.template.form.integration.id</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="x_integration_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_integration_id" model="ir.ui.view">
        <field name="name">product.template.tree.integration.id</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="x_integration_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_integration_id" model="ir.ui.view">
        <field name="name">product.template.search.integration.id</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="x_integration_id" string="ID"/>
            </field>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Has ID" name="has_integration_id" domain="[('x_integration_id', '!=', False)]"/>
                <filter string="Missing ID" name="missing_integration_id" domain="[('x_integration_id', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
